\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Bracket matching length generalisation. All field variants improve over baseline. Notably, \emph  {scalar feedback outperforms dual additive} at 3$\times $ (0.504 vs 0.313)---the reverse of parity and cumsum. Gating achieves perfect 2$\times $ but collapses at 3$\times $.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:brackets}{{3}{5}{Bracket matching length generalisation. All field variants improve over baseline. Notably, \emph {scalar feedback outperforms dual additive} at 3$\times $ (0.504 vs 0.313)---the reverse of parity and cumsum. Gating achieves perfect 2$\times $ but collapses at 3$\times $}{table.3}{}}
