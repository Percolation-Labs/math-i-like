\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Final TinyStories results after one epoch. The social field model matches the parameter-matched baseline in aggregate perplexity (within 0.01). The 1.8$\times $ baseline demonstrates that raw capacity still dominates when available---the social field's value is \emph  {architectural}, enabling capabilities (state tracking, entity coherence) that cannot be achieved by scaling alone.}}{6}{table.4}\protected@file@percent }
\newlabel{tab:tinystories_final}{{4}{6}{Final TinyStories results after one epoch. The social field model matches the parameter-matched baseline in aggregate perplexity (within 0.01). The 1.8$\times $ baseline demonstrates that raw capacity still dominates when available---the social field's value is \emph {architectural}, enabling capabilities (state tracking, entity coherence) that cannot be achieved by scaling alone}{table.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Final results.}{6}{table.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Generation quality.}{7}{section*.12}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Generated stories from final models (step 14,465). The social field model consistently produces richer narrative structure: multi-entity interactions (dragon $\rightarrow $ children $\rightarrow $ cave exploration), coherent action sequences (coats $\rightarrow $ car $\rightarrow $ buckle $\rightarrow $ park $\rightarrow $ slide), and character-driven plots (old man helps bird, girl volunteers). The baseline tends toward repetitive phrasing (``brush their teeth\ldots  did not want to brush their teeth'') and simpler cause-effect chains. Both models have identical perplexity (Table~\ref {tab:tinystories_final}), so this qualitative difference reflects \emph  {how} the models allocate capacity, not how much they have.}}{7}{table.5}\protected@file@percent }
\newlabel{tab:stories}{{5}{7}{Generated stories from final models (step 14,465). The social field model consistently produces richer narrative structure: multi-entity interactions (dragon $\rightarrow $ children $\rightarrow $ cave exploration), coherent action sequences (coats $\rightarrow $ car $\rightarrow $ buckle $\rightarrow $ park $\rightarrow $ slide), and character-driven plots (old man helps bird, girl volunteers). The baseline tends toward repetitive phrasing (``brush their teeth\ldots did not want to brush their teeth'') and simpler cause-effect chains. Both models have identical perplexity (Table~\ref {tab:tinystories_final}), so this qualitative difference reflects \emph {how} the models allocate capacity, not how much they have}{table.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}TinyStories Analysis: Social Field Internals}{7}{section.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Training Dynamics}{7}{subsection.6.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Training and validation loss curves for all three models over one epoch of TinyStories ($\sim $14.5K steps). The social field (30.8M) tracks the baseline (29.9M) almost exactly---the field adds no measurable overhead to convergence. The 1.8$\times $ baseline (52.8M) shows clear improvement from raw capacity.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:training_curves}{{2}{8}{Training and validation loss curves for all three models over one epoch of TinyStories ($\sim $14.5K steps). The social field (30.8M) tracks the baseline (29.9M) almost exactly---the field adds no measurable overhead to convergence. The 1.8$\times $ baseline (52.8M) shows clear improvement from raw capacity}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Per-Position Loss: Where the Field Helps}{8}{subsection.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Aggregate per-position loss comparison across 12 test stories, bucketed into position ranges with standard error bars. The social field is better at 52.1\% of positions. Early advantage (+0.078 at positions 0--4) reflects faster context initialisation; late advantage (+0.053 at positions $\geq $15) reflects accumulated state helping predict later tokens.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:aggregate_loss}{{3}{8}{Aggregate per-position loss comparison across 12 test stories, bucketed into position ranges with standard error bars. The social field is better at 52.1\% of positions. Early advantage (+0.078 at positions 0--4) reflects faster context initialisation; late advantage (+0.053 at positions $\geq $15) reflects accumulated state helping predict later tokens}{figure.3}{}}
